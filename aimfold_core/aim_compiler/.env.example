# aimfold_core/aim_compiler — LLM provider config for live Aim Compiler use.
# Copy to `.env` in this directory (already gitignored via the root *.env
# pattern) and fill in real values. Never commit the real .env.

# Provider switch — 'anthropic' (default) or 'gemini'. This repo's own
# live testing throughout the PR1-19 dev sequence used AI_PROVIDER=gemini
# with GEMINI_API_KEY, since gemini-flash-lite-latest is inexpensive
# enough for repeated live verification during development.
AI_PROVIDER=gemini

# Required if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required if AI_PROVIDER=gemini
GEMINI_API_KEY=

# Optional. gemini-flash-latest (GeminiLLMClient's default) has repeatedly
# 503'd under load during this dev sequence's own live testing — set this
# to gemini-flash-lite-latest (what most of that testing actually used)
# if you hit the same thing.
GEMINI_MODEL=

# Required for POST /aims/propose only (not /aims/compile) — this is the
# service-role key, kept server-side, never sent to the browser. Used to
# persist an approved Aim after independently re-validating its
# compiled_spec and checking the caller's real tenant membership; see
# api.py's module docstring.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
