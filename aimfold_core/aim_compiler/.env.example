# aimfold_core/aim_compiler — LLM provider config for live Aim Compiler use.
# Copy to `.env` in this directory (already gitignored via the root *.env
# pattern) and fill in real values. Never commit the real .env.

# Provider switch — 'anthropic' (default) or 'gemini'. This repo's own
# live testing throughout the PR1-19 dev sequence used AI_PROVIDER=gemini
# with GEMINI_API_KEY, since gemini-flash-lite-latest is inexpensive
# enough for repeated live verification during development.
AI_PROVIDER=gemini

# Required if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required if AI_PROVIDER=gemini
GEMINI_API_KEY=
